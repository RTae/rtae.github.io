{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- /* Pages that canonicalise to another host are deliberately omitted:
         a sitemap should only advertise URLs you want indexed. */ -}}
  {{ range .Data.Pages }}{{ if and .Permalink (not .Params.external_url) (not (and (eq .Kind "term") (lt (len .Pages) 2))) }}
  <url>
    <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>{{ end }}
  </url>{{ end }}{{ end }}
</urlset>
